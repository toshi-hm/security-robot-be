# Copy this file to `.env` (for local development) or provide a custom environment file
# when deploying with Docker Compose. Replace placeholder secrets before running.

# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Database
POSTGRES_USER=security_robot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=security_robot
DATABASE_URL=postgresql+asyncpg://security_robot:change_me@postgres:5432/security_robot

# Cache / task queue
REDIS_URL=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=2
